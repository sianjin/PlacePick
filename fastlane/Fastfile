default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    scan(scheme: "PlacePick")
  end

  # xcodegen regenerates Info.plist's CFBundleVersion from project.yml's static
  # CURRENT_PROJECT_VERSION on every `xcodegen generate` run, silently undoing whatever
  # increment_build_number set locally on the previous release.
  #
  # latest_testflight_build_number was tried first but is unreliable under rapid
  # successive uploads: it only counts builds that have reached PROCESSING state on
  # Apple's servers (excludes AWAITING_UPLOAD), and Apple's upload→PROCESSING transition
  # can lag behind how fast we can iterate — a query issued shortly after a successful
  # upload can still return a stale (older) number, causing a collision on the very next
  # upload. A plain local counter file, incremented unconditionally on every release
  # regardless of Apple's processing state, is the only value guaranteed never to repeat.
  def next_build_number
    # fastlane runs lanes with cwd already set to the fastlane/ directory itself, so this
    # must be the bare filename, not "fastlane/build_number.txt" (which would resolve to
    # fastlane/fastlane/build_number.txt and fail — see docs.fastlane.tools/advanced/#directory-behavior).
    counter_path = "build_number.txt"
    current = File.exist?(counter_path) ? File.read(counter_path).strip.to_i : 0
    next_number = current + 1
    File.write(counter_path, next_number.to_s)
    next_number
  end

  def set_build_number
    increment_build_number(build_number: next_build_number.to_s)
  end

  desc "Upload to TestFlight (internal testers)"
  lane :beta do |options|
    set_build_number unless options[:skip_build_increment]
    gym(scheme: "PlacePick", export_method: "app-store", export_options: "fastlane/ExportOptions.plist")
    pilot(skip_waiting_for_build_processing: true)
  end

  desc "Upload to TestFlight and distribute to external testers"
  lane :beta_external do |options|
    set_build_number
    gym(scheme: "PlacePick", export_method: "app-store", export_options: "fastlane/ExportOptions.plist")
    pilot(
      distribute_external: true,
      groups: ["External Testers"],
      changelog: options[:changelog] || "Bug fixes and improvements",
      skip_waiting_for_build_processing: false
    )
  end

  desc "Submit the latest TestFlight build for App Store review"
  lane :release do
    deliver(
      build_number: latest_testflight_build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true
    )
  end

  desc "Build, upload, and submit a fresh build to the App Store"
  lane :release_full do |options|
    increment_version_number(version_number: options[:version]) if options[:version]
    set_build_number
    gym(scheme: "PlacePick", export_method: "app-store", export_options: "fastlane/ExportOptions.plist")
    deliver(
      submit_for_review: true,
      automatic_release: options[:auto_release] == true,
      force: true,
      overwrite_screenshots: true
    )
  end
end
