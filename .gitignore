# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# XcodeGen-generated project and Info.plist (regenerate via `xcodegen generate` from project.yml)
*.xcodeproj
PlacePick/Info.plist
PlacePickShareExtension/Info.plist

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Simulator / build products
*.ipa
*.dSYM.zip
*.dSYM

# Code signing artifacts (regenerate via `fastlane sigh`, never commit)
*.mobileprovision

# fastlane build/test artifacts (not source)
fastlane/report.xml
fastlane/test_output/

# frameit inputs: raw pre-frame screenshots and copied system font (regenerate via `fastlane frameit`)
# NOTE: screenshot_originals lives outside fastlane/screenshots/ because `deliver` validates
# every subdirectory of fastlane/screenshots/ as an App Store locale code and errors otherwise.
fastlane/screenshot_originals/
fastlane/screenshots/SFNS.ttf
